@inject Microsoft.Extensions.Localization.IStringLocalizer<AddCurrentAccount> L
@page "/add-current-account"

<PageTitle>Add CurrentAccount</PageTitle>
    <RadzenColumn SizeMD=12>
        <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@errorVisible">Cannot save CurrentAccount</RadzenAlert>
        <RadzenTemplateForm TItem="Lightbase.Models.inventory.CurrentAccount" Data="@(currentAccount)" Visible="@(currentAccount != null)" Submit="@FormSubmit">
          <RadzenStack>
            <RadzenFormField Text="Description" Variant="Variant.Outlined">
                  <ChildContent>
                    <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(currentAccount.Description)" Name="Description" />
              </ChildContent>
            </RadzenFormField>
            <RadzenFormField Text="Balance" Variant="Variant.Outlined">
                  <ChildContent>
                    <RadzenNumeric style="display: block; width: 100%" @bind-Value="@(currentAccount.Balance)" Name="Balance"/>
              </ChildContent>
            </RadzenFormField>
            <RadzenFormField Text="Updated On" Variant="Variant.Outlined">
                  <ChildContent>
                    <RadzenNumeric style="display: block; width: 100%" @bind-Value="@(currentAccount.UpdatedOn)" Name="UpdatedOn"/>
              </ChildContent>
            </RadzenFormField>
          </RadzenStack>
          <RadzenStack style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Save" Variant="Variant.Flat" />
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Variant="Variant.Flat" Click="@CancelButtonClick"  />
          </RadzenStack>
        </RadzenTemplateForm>
    </RadzenColumn>

